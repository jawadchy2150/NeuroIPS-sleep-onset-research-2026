# Copy to .env if you want a local file of exports. .env is gitignored.
# This repository does not load .env automatically. Export the variables
# yourself before a run, for example:  set -a; source .env; set +a

# Official Benchopt selector (benchmark_utils.data.get_device).
# Unset: CUDA when torch.cuda.is_available(), otherwise CPU.
# Set cpu to force CPU. Set mps only when you intend the official solvers
# to run on Apple Silicon; that string is passed through as-is.
# COMPET_DEVICE=

# Team experiments (muse_experiments.device.resolve_device).
# auto tries CUDA, then MPS, then CPU.
# MUSE_DEVICE=auto

# Muse EEG root. Unset uses the NeuralBench cache path under your home
# directory (the location prepare_muse_features.py already reads).
# NEURALBENCH_MUSE_ROOT=

# Benchopt data directory. Leave unset unless a machine should store
# prepared studies somewhere other than the Benchopt default.
# BENCHOPT_DATA_HOME=
